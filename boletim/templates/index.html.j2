{#
  Índice do site: o arquivo das edições, da mais recente para a mais antiga.

  Mesma paleta e mesma tipografia do e-mail, sem botão. Aqui quem já chegou
  não precisa ser convidado de novo: a luz é o link da edição.
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Radar de captação em saúde</title>
<style>
a { overflow-wrap: anywhere; }
@media only screen and (max-width:480px) {
  .card { padding: 16px !important; }
}
@media (prefers-color-scheme: dark) {
  .logo-claro { display: none !important; }
  .logo-escuro { display: block !important; }
}
</style>
</head>
<body style="margin:0; padding:0; background-color:#f5f7f9;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f7f9" style="background-color:#f5f7f9;">
<tr>
<td align="center" style="padding:0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; margin:0 auto;">

<tr>
<td style="padding:24px 16px;">
<img class="logo-claro" src="{{ url_logo_navy }}" width="140" alt="Thauma" style="display:block; width:140px; max-width:100%; height:auto; border:0;">
<img class="logo-escuro" src="{{ url_logo_branco }}" width="140" alt="Thauma" style="display:none; width:140px; max-width:100%; height:auto; border:0;">
</td>
</tr>

<tr>
<td style="padding:0 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FFFFFF; border:1px solid #dde4ee;">
<tr>
<td class="card" style="padding:32px;">
<h1 style="margin:0 0 16px; font-family:Georgia, 'Times New Roman', serif; font-size:28px; font-weight:500; line-height:1.25; letter-spacing:-0.02em; color:#00051f;">Radar de captação em saúde</h1>
<p style="margin:0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:17px; line-height:1.65; color:#1c2438;">Todo dia útil, o que o Diário Oficial da União e o Diário Oficial de Minas Gerais publicaram sobre dinheiro, regra e edital em saúde.</p>
</td>
</tr>
</table>
</td>
</tr>

{% for edicao in edicoes %}
<tr><td height="24" style="height:24px; line-height:24px; font-size:0;">&nbsp;</td></tr>
<tr>
<td style="padding:0 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FFFFFF; border:1px solid #dde4ee;">
<tr>
<td class="card" style="padding:32px;">
<p style="margin:0 0 8px; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:15px; line-height:1.5;"><a href="{{ edicao.url|e }}" style="color:#0060e0; text-decoration:underline;">{{ edicao.data|data_extenso }}</a></p>
<p style="margin:0; font-family:Georgia, 'Times New Roman', serif; font-size:20px; font-weight:500; line-height:1.3; color:#00051f;">{{ edicao.titulo|sem_travessao }}</p>
<p style="margin:8px 0 0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:14px; line-height:1.6; color:#5a6280;">{{ edicao.contagens["A"] }} captação · {{ edicao.contagens["B"] }} regra · {{ edicao.contagens["C"] }} editais{% if edicao.parcial %} · coleta parcial{% endif %}</p>
</td>
</tr>
</table>
</td>
</tr>
{% endfor %}

<tr><td height="48" style="height:48px; line-height:48px; font-size:0;">&nbsp;</td></tr>
<tr>
<td style="padding:0 16px 32px;">
<p style="margin:0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:14px; line-height:1.6; color:#5a6280;">Thauma · inteligência e narrativa em saúde</p>
<p style="margin:16px 0 0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:14px; line-height:1.6; color:#5a6280;"><a href="{{ cta_url }}" style="color:#0060e0; text-decoration:underline;">Conversar no WhatsApp: {{ cta_whatsapp_legivel }}</a></p>
</td>
</tr>

</table>
</td>
</tr>
</table>
</body>
</html>
