{#
  Índice do site: o arquivo das edições, da mais recente para a mais antiga.

  Mesma família visual do e-mail: mesmo fundo, mesma folha branca única, mesmos
  filetes, mesma pilha tipográfica. Sem botão. Aqui quem já chegou não precisa
  ser convidado de novo: a luz é o link da edição.

  As classes de repintura são as mesmas do e-mail, pelo mesmo motivo: trocar o
  logo por branco sem trocar o chão deixaria a marca invisível.
#}
{% macro filete() %}
<tr><td class="filete" style="border-top:1px solid #dde4ee; height:1px; line-height:1px; font-size:0;">&nbsp;</td></tr>
{% endmacro %}
{% macro espaco(altura) %}
<tr><td height="{{ altura }}" style="height:{{ altura }}px; line-height:{{ altura }}px; font-size:0;">&nbsp;</td></tr>
{% endmacro %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Radar de captação em saúde</title>
<style>
a { overflow-wrap: anywhere; }
@media only screen and (max-width:480px) {
  .recheio { padding: 16px !important; }
  .titulo-indice { font-size: 28px !important; }
}
@media (prefers-color-scheme: dark) {
  .logo-claro { display: none !important; }
  .logo-escuro { display: block !important; }
  .fundo { background-color: #00051f !important; }
  .folha { background-color: #050a25 !important; border-color: #1a2246 !important; }
  .titulo { color: #FFFFFF !important; }
  .corpo { color: #c7d2e8 !important; }
  .muted { color: #8b95b5 !important; }
  .filete { border-color: #1a2246 !important; }
  .link { color: #40D7FF !important; }
}
</style>
</head>
<body class="fundo" style="margin:0; padding:0; background-color:#f5f7f9;">
<table class="fundo" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f7f9" style="background-color:#f5f7f9;">
<tr>
<td align="center" style="padding:0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; margin:0 auto;">

<tr>
<td style="padding:24px 16px;">
<img class="logo-claro" src="{{ url_logo_navy }}" width="140" alt="Thauma" style="display:block; width:140px; max-width:100%; height:auto; border:0;">
<img class="logo-escuro" src="{{ url_logo_branco }}" width="140" alt="Thauma" style="display:none; width:140px; max-width:100%; height:auto; border:0;">
<h1 class="titulo titulo-indice" style="margin:16px 0 0; font-family:Georgia, 'Times New Roman', serif; font-size:32px; font-weight:400; line-height:1.2; letter-spacing:-0.02em; color:#00051f;">Radar de captação em saúde</h1>
<p class="corpo" style="margin:24px 0 0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:17px; line-height:1.65; color:#1c2438;">Todo dia útil, o que o Diário Oficial da União e o Diário Oficial de Minas Gerais publicaram sobre dinheiro, regra e edital em saúde.</p>
</td>
</tr>

<tr>
<td style="padding:0 16px;">
<table class="folha" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FFFFFF; border:1px solid #dde4ee;">
<tr>
<td class="recheio" style="padding:32px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{% for edicao in edicoes %}
{% if not loop.first %}{{ espaco(32) }}{{ filete() }}{{ espaco(32) }}{% endif %}
<tr>
<td>
<p style="margin:0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:15px; line-height:1.5;"><a class="link" href="{{ edicao.url|e }}" style="color:#0060e0; text-decoration:underline;">{{ edicao.data|data_extenso }}</a></p>
<p class="titulo" style="margin:8px 0 0; font-family:Georgia, 'Times New Roman', serif; font-size:21px; font-weight:400; line-height:1.3; letter-spacing:-0.01em; color:#00051f;">{{ edicao.titulo|sem_travessao }}</p>
<p class="muted" style="margin:8px 0 0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:14px; line-height:1.6; color:#5a6280;">{{ edicao.contagens|resumo_edicao(edicao.parcial) }}</p>
</td>
</tr>
{% endfor %}
</table>
</td>
</tr>
</table>
</td>
</tr>

{{ espaco(48) }}
<tr>
<td style="padding:0 16px 32px;">
<p class="muted" style="margin:0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:14px; line-height:1.6; color:#5a6280;">Thauma. Inteligência e narrativa em saúde.</p>
<p class="muted" style="margin:16px 0 0; font-family:-apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size:14px; line-height:1.6; color:#5a6280;"><a class="link" href="{{ cta_url }}" style="color:#0060e0; text-decoration:underline;">Conversar no WhatsApp: {{ cta_whatsapp_legivel }}</a></p>
</td>
</tr>

</table>
</td>
</tr>
</table>
</body>
</html>
